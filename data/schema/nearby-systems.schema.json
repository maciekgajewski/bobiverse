{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bobiverse.local/schema/nearby-systems-4.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "systems"],
  "properties": {
    "schema_version": { "const": "4.0.0" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_at",
        "coordinate_frame",
        "units",
        "render_mapping",
        "configuration",
        "coverage",
        "sources"
      ],
      "properties": {
        "generated_at": { "type": "string", "minLength": 1 },
        "coordinate_frame": { "const": "Sun-centered Galactic Cartesian" },
        "units": { "const": "pc" },
        "render_mapping": { "const": "scene.x=Xg; scene.y=Zg; scene.z=-Yg" },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["context_radius_ly"],
          "properties": {
            "context_radius_ly": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "coverage": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/coverage" }
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gcns",
            "cns5",
            "gaia_dr3",
            "wds",
            "c20pc",
            "classical_names"
          ],
          "properties": {
            "gcns": { "$ref": "#/$defs/source" },
            "cns5": { "$ref": "#/$defs/source" },
            "gaia_dr3": { "$ref": "#/$defs/source" },
            "wds": { "$ref": "#/$defs/wds_source" },
            "c20pc": { "$ref": "#/$defs/c20pc_source" },
            "classical_names": { "$ref": "#/$defs/source" }
          }
        }
      }
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/system" }
    }
  },
  "$defs": {
    "nullable_number": { "type": ["number", "null"] },
    "nullable_object_class": {
      "type": ["string", "null"],
      "enum": ["star", "white_dwarf", "brown_dwarf", null]
    },
    "c20pc_enrichment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_key",
        "published_name",
        "common_name",
        "wise_id",
        "twomass_id",
        "hd_id",
        "ross_id",
        "wd_id",
        "gaia_id",
        "hip_id",
        "gj_id",
        "pmjid",
        "multiple_designations",
        "spectral_type",
        "spectral_type_optical",
        "spectral_type_near_infrared",
        "effective_temperature_k",
        "effective_temperature_error_k",
        "object_class",
        "visual_family",
        "system_hierarchy",
        "system_code",
        "reference_codes"
      ],
      "properties": {
        "source_key": { "type": "string", "minLength": 1 },
        "published_name": { "type": ["string", "null"] },
        "common_name": { "type": ["string", "null"] },
        "wise_id": { "type": ["string", "null"] },
        "twomass_id": { "type": ["string", "null"] },
        "hd_id": { "type": ["string", "null"] },
        "ross_id": { "type": ["string", "null"] },
        "wd_id": { "type": ["string", "null"] },
        "gaia_id": { "type": ["string", "null"] },
        "hip_id": { "type": ["string", "null"] },
        "gj_id": { "type": ["string", "null"] },
        "pmjid": { "type": ["string", "null"] },
        "multiple_designations": { "type": ["string", "null"] },
        "spectral_type": { "type": ["string", "null"] },
        "spectral_type_optical": { "type": ["string", "null"] },
        "spectral_type_near_infrared": { "type": ["string", "null"] },
        "effective_temperature_k": { "$ref": "#/$defs/nullable_number" },
        "effective_temperature_error_k": {
          "$ref": "#/$defs/nullable_number"
        },
        "object_class": { "$ref": "#/$defs/nullable_object_class" },
        "visual_family": {
          "type": ["string", "null"],
          "enum": ["infrared-cool", "infrared-warm", null]
        },
        "system_hierarchy": { "type": ["string", "null"] },
        "system_code": { "type": ["integer", "null"] },
        "reference_codes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xg", "yg", "zg"],
      "properties": {
        "xg": { "type": "number" },
        "yg": { "type": "number" },
        "zg": { "type": "number" }
      }
    },
    "render_position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalised_sha256", "row_count", "acknowledgement"],
      "properties": {
        "normalised_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "row_count": { "type": "integer", "minimum": 0 },
        "acknowledgement": { "type": "string", "minLength": 1 }
      }
    },
    "wds_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_sha256",
        "candidate_sha256",
        "row_count",
        "candidate_row_count",
        "acknowledgement"
      ],
      "properties": {
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "row_count": { "type": "integer", "minimum": 1 },
        "candidate_row_count": { "type": "integer", "minimum": 0 },
        "acknowledgement": { "type": "string", "minLength": 1 }
      }
    },
    "c20pc_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table4_sha256",
        "notes_sha256",
        "references_sha256",
        "table4_row_count",
        "notes_row_count",
        "reference_row_count",
        "acknowledgement"
      ],
      "properties": {
        "table4_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "notes_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "references_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "table4_row_count": { "type": "integer", "minimum": 1 },
        "notes_row_count": { "type": "integer", "minimum": 1 },
        "reference_row_count": { "type": "integer", "minimum": 1 },
        "acknowledgement": { "type": "string", "minLength": 1 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_id",
        "anchor_position_pc",
        "radius_ly",
        "system_count",
        "source_record_count",
        "gcns_boundary_pc"
      ],
      "properties": {
        "anchor_id": { "type": "string", "minLength": 1 },
        "anchor_position_pc": { "$ref": "#/$defs/position" },
        "radius_ly": { "type": "number", "exclusiveMinimum": 0 },
        "system_count": { "type": "integer", "minimum": 0 },
        "source_record_count": { "type": "integer", "minimum": 0 },
        "gcns_boundary_pc": { "const": 100 }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "gaia_source_id",
        "cns5_id",
        "source_identities",
        "gaia_enrichment",
        "c20pc_enrichment",
        "object_class",
        "designation",
        "identifiers",
        "icrs",
        "astrometry_quality",
        "photometry",
        "visual",
        "provenance"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "gaia_source_id": { "type": ["string", "null"], "pattern": "^[0-9]+$" },
        "cns5_id": { "type": ["string", "null"], "minLength": 1 },
        "source_identities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "gaia_enrichment": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "phot_g_mean_mag",
                "phot_bp_mean_mag",
                "phot_rp_mean_mag",
                "bp_rp",
                "radial_velocity_km_s",
                "radial_velocity_error_km_s",
                "phot_variable_flag",
                "non_single_star",
                "effective_temperature_k",
                "logg_gspphot",
                "luminosity_solar",
                "radius_solar",
                "spectral_type",
                "star_class_probability",
                "variability_class",
                "variability_class_score"
              ],
              "properties": {
                "phot_g_mean_mag": { "$ref": "#/$defs/nullable_number" },
                "phot_bp_mean_mag": { "$ref": "#/$defs/nullable_number" },
                "phot_rp_mean_mag": { "$ref": "#/$defs/nullable_number" },
                "bp_rp": { "$ref": "#/$defs/nullable_number" },
                "radial_velocity_km_s": {
                  "$ref": "#/$defs/nullable_number"
                },
                "radial_velocity_error_km_s": {
                  "$ref": "#/$defs/nullable_number"
                },
                "phot_variable_flag": { "type": ["string", "null"] },
                "non_single_star": { "type": ["string", "null"] },
                "effective_temperature_k": {
                  "$ref": "#/$defs/nullable_number"
                },
                "logg_gspphot": { "$ref": "#/$defs/nullable_number" },
                "luminosity_solar": { "$ref": "#/$defs/nullable_number" },
                "radius_solar": { "$ref": "#/$defs/nullable_number" },
                "spectral_type": { "type": ["string", "null"] },
                "star_class_probability": {
                  "$ref": "#/$defs/nullable_number"
                },
                "variability_class": { "type": ["string", "null"] },
                "variability_class_score": {
                  "$ref": "#/$defs/nullable_number"
                }
              }
            }
          ]
        },
        "c20pc_enrichment": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/c20pc_enrichment" }]
        },
        "object_class": { "$ref": "#/$defs/nullable_object_class" },
        "designation": { "type": "string", "minLength": 1 },
        "identifiers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gaia_dr3_source_id",
            "gcns_source_id",
            "cns5_id",
            "gj_id",
            "hip_id",
            "cns5_component_id",
            "cns6_system_id",
            "c20pc_source_key",
            "wise_id",
            "twomass_id",
            "published_name",
            "bayer_designation",
            "flamsteed_designation",
            "hd_id",
            "hr_id"
          ],
          "properties": {
            "gaia_dr3_source_id": { "type": ["string", "null"] },
            "gcns_source_id": { "type": ["string", "null"] },
            "cns5_id": { "type": ["string", "null"] },
            "gj_id": { "type": ["string", "null"] },
            "hip_id": { "type": ["string", "null"] },
            "cns5_component_id": { "type": ["string", "null"] },
            "cns6_system_id": { "type": ["string", "null"] },
            "c20pc_source_key": { "type": ["string", "null"] },
            "wise_id": { "type": ["string", "null"] },
            "twomass_id": { "type": ["string", "null"] },
            "published_name": { "type": ["string", "null"] },
            "bayer_designation": { "type": ["string", "null"] },
            "flamsteed_designation": { "type": ["string", "null"] },
            "hd_id": { "type": ["string", "null"] },
            "hr_id": { "type": ["string", "null"] }
          }
        },
        "icrs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ra_deg",
            "dec_deg",
            "epoch_year",
            "parallax_mas",
            "parallax_error_mas"
          ],
          "properties": {
            "ra_deg": { "$ref": "#/$defs/nullable_number" },
            "dec_deg": { "$ref": "#/$defs/nullable_number" },
            "epoch_year": { "$ref": "#/$defs/nullable_number" },
            "parallax_mas": { "$ref": "#/$defs/nullable_number" },
            "parallax_error_mas": { "$ref": "#/$defs/nullable_number" }
          }
        },
        "astrometry_quality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parallax_over_error",
            "visibility_periods_used",
            "ruwe"
          ],
          "properties": {
            "parallax_over_error": { "$ref": "#/$defs/nullable_number" },
            "visibility_periods_used": { "type": ["integer", "null"] },
            "ruwe": { "$ref": "#/$defs/nullable_number" }
          }
        },
        "photometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["g_magnitude", "bp_rp"],
          "properties": {
            "g_magnitude": { "$ref": "#/$defs/nullable_number" },
            "bp_rp": { "$ref": "#/$defs/nullable_number" }
          }
        },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color_family",
            "marker_radius",
            "intensity",
            "pick_radius",
            "derivation",
            "source_facts"
          ],
          "properties": {
            "color_family": {
              "enum": [
                "blue",
                "blue-white",
                "white",
                "yellow",
                "orange",
                "red",
                "neutral",
                "infrared-cool",
                "infrared-warm"
              ]
            },
            "marker_radius": { "type": "number", "exclusiveMinimum": 0 },
            "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
            "pick_radius": { "type": "number", "exclusiveMinimum": 0 },
            "derivation": { "type": "string", "minLength": 1 },
            "source_facts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "effective_temperature_k",
                "spectral_type",
                "bp_rp",
                "wds_spectral_type",
                "c20pc_effective_temperature_k",
                "c20pc_spectral_type",
                "object_class"
              ],
              "properties": {
                "effective_temperature_k": {
                  "$ref": "#/$defs/nullable_number"
                },
                "spectral_type": { "type": ["string", "null"] },
                "bp_rp": { "$ref": "#/$defs/nullable_number" },
                "wds_spectral_type": { "type": ["string", "null"] },
                "c20pc_effective_temperature_k": {
                  "$ref": "#/$defs/nullable_number"
                },
                "c20pc_spectral_type": { "type": ["string", "null"] },
                "object_class": { "$ref": "#/$defs/nullable_object_class" }
              }
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position", "catalogues", "enrichment"],
          "properties": {
            "position": { "type": ["string", "null"] },
            "catalogues": { "type": "array", "items": { "type": "string" } },
            "enrichment": { "type": ["string", "null"] }
          }
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "alternates",
        "position_pc",
        "render_position",
        "distance_from_sol_pc",
        "distance_uncertainty_pc",
        "components",
        "provenance"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "alternates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "position_pc": { "$ref": "#/$defs/position" },
        "render_position": { "$ref": "#/$defs/render_position" },
        "distance_from_sol_pc": { "type": "number", "minimum": 0 },
        "distance_uncertainty_pc": { "type": ["number", "null"], "minimum": 0 },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component" }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "catalogues",
            "source_object_ids",
            "adopted_component_id",
            "review_version",
            "wds_designations"
          ],
          "properties": {
            "catalogues": { "type": "array", "items": { "type": "string" } },
            "source_object_ids": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            },
            "adopted_component_id": { "type": "string", "minLength": 1 },
            "review_version": { "type": "string", "minLength": 1 },
            "wds_designations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "wds_coordinate",
                  "discoverer",
                  "components",
                  "component_ids",
                  "membership_action",
                  "reason"
                ],
                "properties": {
                  "wds_coordinate": { "type": "string", "minLength": 1 },
                  "discoverer": { "type": "string", "minLength": 1 },
                  "components": { "type": "string" },
                  "component_ids": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "membership_action": {
                    "enum": ["confirm", "replace"]
                  },
                  "reason": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
