{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bobiverse.local/schema/major-local-systems-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "systems"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system_id", "name", "components"],
        "properties": {
          "system_id": {
            "type": "string",
            "pattern": "^stellar-system-[0-9]{6}$"
          },
          "name": { "type": "string", "minLength": 1 },
          "components": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["component_id", "name"],
              "properties": {
                "component_id": {
                  "type": "string",
                  "pattern": "^stellar-component-[0-9]{6}$"
                },
                "name": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
