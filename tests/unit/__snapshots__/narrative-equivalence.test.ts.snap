          {
            "current_state": "Continuing training and assembly as the sole remaining probe candidate. His software safeguards remain incompletely understood.",
            "entity_type": "character",
            "id": "character:bob-replicant",
            "last_known_location": {
              "effective_date": "2133",
              "location_id": "location:new-handeltown",
              "source_chapter": "1.11",
            },
            "name": "Bob",
          },
          {
            "current_state": "Away from the project while Dr. Doucette covers for him.",
            "entity_type": "character",
            "id": "character:dr-landers",
            "last_known_location": {
              "effective_date": "2133",
              "location_id": "location:new-handeltown",
              "source_chapter": "1.10",
            },
            "name": "Dr. Landers",
          },
          {
            "description": "The Free American Independent Theocratic Hegemony, a theocratic U.S. government that makes criticism a felony and permits the deactivation of machine persons for it. It restricts information by default; the domestic internet no longer exists, and genealogy records are unavailable to the public. It is divided into factions and power blocs, including factions that regard artificial intelligence and replicants as abominations or advocate abandoning technology from steam power onward. It finances the replicant project and owns Bob. It controls most of North America, while several internal factions oppose Project HEAVEN, the Habitable Earths Abiogenic Vessel Exploration Network, and seek to stop it. Security personnel believe internal factions leaked the project's progress to provoke competing nations into reacting.",
            "entity_type": "organization",
            "id": "organization:free-american-independent-theocratic-hegemony",
            "name": "FAITH",
          },
          {
            "description": "A company that owns Bob as property and develops replicant-controlled machinery.",
            "entity_type": "organization",
            "id": "organization:applied-synergetics",
            "name": "Applied Synergetics Inc.",
          },
          {
            "description": "An interface that offloads tasks for replicants while retaining their human limits on multitasking. Its name expands to General Unit Primary Peripheral Interface, and its logs retain monitoring-interface and script activity.",
            "entity_type": "technology",
            "id": "technology:guppi-interface",
            "name": "GUPPI",
          },
          {
            "description": "Remote observation and manipulation devices directed through GUPPI. They come in varied sizes, can coordinate across scales, and need minimal supervision once their tasks, dependencies, and interruption conditions are defined. Without active intervention, they can work up to ten times faster. They can travel along floors, walls, and ceilings, carry video cameras for remote observation, and pick up vibrations transmitted through a wall when pressed against it. Reusable scripts automate many routine activities, leaving assembly work largely self-directed.",
            "entity_type": "technology",
            "id": "technology:roamers",
            "name": "ROAMers",
          },
          {
            "description": "Variable Attachment Surface Tension is a system that gives a ROAMer a secure grip.",
            "entity_type": "technology",
            "id": "technology:vast",
            "name": "VAST",
          },
          {
            "aliases": [
              "Senior Minister Travis",
            ],
            "entity_type": "character",
            "id": "character:minister-travis",
            "last_known_location": {
              "effective_date": "2133",
              "location_id": "location:new-handeltown",
              "source_chapter": "1.5",
            },
            "name": "Minister Travis",
          },
          {
            "description": "A FAITH ministry that finances the replicant venture and has military, colonization, and diplomatic responsibilities. It officially supports and actively funds the replicant enterprise, and holds that the enterprise's machine minds are without souls but are based on God's creation rather than attempts to usurp divine authority.",
            "entity_type": "organization",
            "id": "organization:ministry-of-truth",
            "name": "Ministry of Truth",
          },
          {
            "description": "A FAITH ministry that uses direct neurological stimulation as part of re-education.",
            "entity_type": "organization",
            "id": "organization:ministry-of-proper-thought",
            "name": "Ministry of Proper Thought",
          },
          {
            "description": "A self-replicating spacecraft designed to travel between star systems and construct new copies of itself along the way. Interstellar use became possible after a breakthrough in subspace theory, and such probes are central to a competitive international colonization effort.",
            "entity_type": "technology",
            "id": "technology:von-neumann-probe",
            "name": "Von Neumann probe",
          },
          {
            "description": "Tiny, single-purpose devices used for work below ROAMer scale; their flexibility is limited.",
            "entity_type": "technology",
            "id": "technology:nanites",
            "name": "nanites",
          },
          {
            "description": "A recently developed drive technology enabled by a breakthrough in subspace theory and used to equip spacecraft for interstellar operations. Beyond prototypes, only a small number of SURGE-equipped vessels are in active service.",
            "entity_type": "technology",
            "id": "technology:surge-drive",
            "name": "SURGE drive",
          },
          {
            "description": "A subspace technology enabled by the same theoretical breakthrough as the SURGE drive and associated with the new possibility of interstellar probes and colonization.",
            "entity_type": "technology",
            "id": "technology:suddar",
            "name": "SUDDAR",
          },
          {
            "description": "The United States of Eurasia controls Europe and most of western Russia. It began an interstellar probe project two years earlier, and Dr. Landers considers it the strongest long-term competitor, with a substantial lead in colonization readiness.",
            "entity_type": "organization",
            "id": "organization:united-states-of-eurasia",
            "name": "USE",
          },
          {
            "description": "A major power whose probe project is sacrificing other concerns for speed and is expected to use an AMI. Dr. Landers's organization considers its project the most likely to fail outright.",
            "entity_type": "organization",
            "id": "organization:china",
            "name": "China",
          },
          {
            "description": "A belligerent power believed by Dr. Landers's organization to be potentially arming its probes and to be the most likely sabotage threat. His organization expects it to launch multiple probes and, if it finds a suitable system, establish a military presence and reproduce there.",
            "entity_type": "organization",
            "id": "organization:brazilian-empire",
            "name": "Brazilian Empire",
          },
          {
            "description": "A suspected participant in the international interstellar-probe race, referred to as Australia. Dr. Landers's organization suspects it of operating a probe project.",
            "entity_type": "organization",
            "id": "organization:australia",
            "name": "Australia",
          },
          {
            "current_state": "Gone after the attack that destroyed the replicant matrices; his precise fate has not been revealed.",
            "entity_type": "character",
            "id": "character:kenneth-martins",
            "name": "Kenneth Martins",
          },
          {
            "current_state": "Represented by a candidate cube that is powered down.",
            "entity_type": "character",
            "id": "character:jiro-tanaka",
            "name": "Jiro Tanaka",
          },
          {
            "current_state": "Represented by a candidate cube that is powered down.",
            "entity_type": "character",
