              "source_chapter": "1.9",
            },
            "name": "Minister Jacoby",
          },
          {
            "current_state": "Covering for Dr. Landers while Bob continues his training and assembly work.",
            "entity_type": "character",
            "id": "character:dr-doucette",
            "last_known_location": {
              "effective_date": "2133",
              "location_id": "location:new-handeltown",
